# Copy to .env and fill in real values. NEVER commit .env.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Postgres connection string (use sslmode=require in production)
DATABASE_URL=

# Shared secret issued by the payment gateway dashboard.
# Used to verify the HMAC-SHA256 signature of every webhook delivery.
PAYMENT_WEBHOOK_SECRET=

# How old a signed timestamp may be before the delivery is rejected as a replay.
PAYMENT_WEBHOOK_TOLERANCE_SECONDS=300

# SMTP transport, e.g. smtps://user:pass@smtp.example.com:465
SMTP_URL=
MAIL_FROM=orders@example.com
MERCHANT_NAME=Example Store
MERCHANT_SUPPORT_EMAIL=support@example.com
