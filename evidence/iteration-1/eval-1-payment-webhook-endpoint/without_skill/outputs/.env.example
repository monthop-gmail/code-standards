# Server
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Payment gateway webhook
# Shared secret used to verify the HMAC-SHA256 signature on incoming webhooks.
PAYMENT_WEBHOOK_SECRET=replace-me-with-a-long-random-secret
# Max age (seconds) accepted for the signature timestamp (replay protection).
PAYMENT_WEBHOOK_TOLERANCE_SECONDS=300

# SMTP (confirmation email)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=apikey
SMTP_PASSWORD=replace-me
MAIL_FROM="Acme Store <no-reply@example.com>"
