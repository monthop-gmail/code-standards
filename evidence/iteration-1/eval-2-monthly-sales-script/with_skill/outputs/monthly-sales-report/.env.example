# คัดลอกเป็น .env แล้วใส่ค่าจริง — ห้าม commit ไฟล์ .env
# connection string ของ PostgreSQL (ควรเป็น user ที่มีสิทธิ์ SELECT อย่างเดียว)
DATABASE_URL=postgresql://reporting_ro:CHANGE_ME@localhost:5432/salesdb

# timezone ที่ใช้ตัดเดือน (ค่าเริ่มต้น Asia/Bangkok)
SALES_REPORT_TZ=Asia/Bangkok

# กันไม่ให้ query ค้างยาวจนล็อกทรัพยากรฝั่ง DB (มิลลิวินาที, ค่าเริ่มต้น 30000)
SALES_REPORT_STATEMENT_TIMEOUT_MS=30000
