# คัดลอกเป็น .env แล้วเติมค่าจริง — ห้าม commit ไฟล์ .env
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Postgres
DATABASE_URL=postgres://user:password@localhost:5432/shop

# Secret ที่ payment gateway ใช้เซ็น webhook (ยาวอย่างน้อย 16 ตัวอักษร)
PAYMENT_WEBHOOK_SECRET=
# ช่วงเวลาที่ยอมรับ timestamp บน signature (กัน replay attack)
PAYMENT_WEBHOOK_TOLERANCE_SECONDS=300

# SMTP — เช่น smtps://apikey:SG.xxxx@smtp.sendgrid.net:465
SMTP_URL=
MAIL_FROM="ICB Shop <no-reply@example.com>"
