# คัดลอกเป็น .env แล้วใส่ค่าจริง — ห้าม commit ไฟล์ .env เข้า git
# connection string ของ PostgreSQL (ควรใช้ user ที่มีสิทธิ์ SELECT อย่างเดียว)
DATABASE_URL=postgresql://readonly_user:CHANGE_ME@localhost:5432/shop
# timezone ที่ใช้ตัดเดือน (ไม่ใส่ก็ได้ ค่าเริ่มต้นคือ Asia/Bangkok)
REPORT_TIMEZONE=Asia/Bangkok
